    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.5.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pg-embedded": "^0.2.3",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
