# ==============================================================
# PLATFORM — Environment Variable Reference
# ==============================================================
# Copy this file to .env and fill in values for local development.
#
# SECURITY RULES:
#   - NEVER commit .env to version control.
#   - NEVER use production secrets in .env for local development.
#   - All secrets shown here are DEVELOPMENT PLACEHOLDERS ONLY.
#   - Rotate all secrets before any production deployment.
# ==============================================================

# --------------------------------------------------------------
# APPLICATION
# --------------------------------------------------------------
NODE_ENV=development
APP_NAME=Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --------------------------------------------------------------
# API SERVER
# --------------------------------------------------------------
API_PORT=3001
API_PREFIX=/api
API_VERSION=v1

# Request body size limit
API_BODY_LIMIT_MB=10

# --------------------------------------------------------------
# JWT — ACCESS TOKEN
# Minimum 32 characters. Use a cryptographically random string.
# Generate: openssl rand -hex 32
# --------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-before-any-deployment-!!
JWT_ACCESS_EXPIRY=15m

# --------------------------------------------------------------
# JWT — REFRESH TOKEN
# Refresh tokens are stored as SHA-256 hashes in PostgreSQL.
# This secret is NOT used to sign the refresh token itself.
# The raw refresh token is crypto.randomBytes(64).
# Expiry is enforced via the expiresAt column in RefreshToken.
# --------------------------------------------------------------
JWT_REFRESH_EXPIRY_DAYS=7

# --------------------------------------------------------------
# COOKIE
# SameSite values: Strict | Lax | None
# Use Strict for same-domain deployments.
# Use None (requires Secure=true + HTTPS) for cross-domain.
# See docs/security.md for full cookie policy documentation.
# --------------------------------------------------------------
COOKIE_SECRET=dev-cookie-secret-change-before-any-deployment-!!
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=

# --------------------------------------------------------------
# DATABASE — PostgreSQL
# Local Docker: postgresql://platform:platform@localhost:5432/platform_dev
# Never use real credentials here.
# --------------------------------------------------------------
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform_dev

# Optional: Direct URL bypasses PgBouncer for Prisma migrations
# DATABASE_DIRECT_URL=postgresql://platform:platform@localhost:5432/platform_dev

# --------------------------------------------------------------
# REDIS
# Local Docker: redis://localhost:6379
# --------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins.
# Must be explicit — never use * with credentials.
# --------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------------------------
# RATE LIMITING (Redis-backed — implementation: Day 2)
# Sensitive endpoint limits are enforced even when Redis is down
# via in-process fallback (see docs/security.md).
# --------------------------------------------------------------
# General rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Login / refresh / password endpoints
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000

# In-process fallback (used when Redis unavailable)
RATE_LIMIT_FALLBACK_AUTH_MAX=5
RATE_LIMIT_FALLBACK_AUTH_WINDOW_MS=900000

# --------------------------------------------------------------
# LOGGING
# Levels: error | warn | info | debug | verbose
# --------------------------------------------------------------
LOG_LEVEL=debug

# --------------------------------------------------------------
# FRONTEND (Next.js — public vars prefixed with NEXT_PUBLIC_)
# --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=Platform

# ==============================================================
# PRODUCTION ENVIRONMENT ADDITIONS
# (document here; set via secrets management in production infra)
# ==============================================================
# LOG_LEVEL=info
# NODE_ENV=production
# COOKIE_SAME_SITE=Strict  (or Lax/None depending on topology)
# CORS_ORIGIN=https://app.yourdomain.com
# DATABASE_URL=<production-connection-string>
# REDIS_URL=<production-redis-url>
# JWT_ACCESS_SECRET=<strong-random-64-char-secret>
# COOKIE_SECRET=<strong-random-64-char-secret>
# ==============================================================
